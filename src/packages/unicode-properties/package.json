{
  "name": "@cantoo/unicode-properties",
  "version": "1.0.1",
  "description": "Fast access to unicode character properties (vendored for @cantoo/fontkit)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "generate": "node ./generate.js",
    "build": "node ../../../scripts/build-unicode-packages.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "codepoints": "^1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/cantoo-scribe/fontkit.git",
    "directory": "src/packages/unicode-properties"
  },
  "author": "Devon Govett <devongovett@gmail.com>",
  "contributors": [
    "Cantoo"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "unicode",
    "metadata",
    "character",
    "codepoint"
  ]
}
