{
  "name": "@cantoo/fontkit",
  "version": "2.0.11",
  "description": "An advanced font engine for Node and the browser",
  "keywords": [
    "opentype",
    "font",
    "typography",
    "subset",
    "emoji",
    "glyph",
    "layout"
  ],
  "scripts": {
    "clean": "rm -rf src/opentype/shapers/data.trie src/opentype/shapers/use.trie src/opentype/shapers/use.json src/opentype/shapers/indic.trie src/opentype/shapers/indic.json dist src/packages/unicode-trie/dist src/packages/unicode-properties/dist",
    "trie:data": "node src/opentype/shapers/generate-data.js",
    "trie:use": "node src/opentype/shapers/gen-use.js",
    "trie:indic": "node src/opentype/shapers/gen-indic.js",
    "tries": "npm run trie:data && npm run trie:use && npm run trie:indic",
    "build:packages": "node scripts/build-unicode-packages.js",
    "build:types": "node scripts/build-types.js",
    "build:mirror": "node scripts/mirror-unicode-dist.js",
    "build": "npm run build:packages && tsup && npm run build:types && npm run build:mirror",
    "prebuild": "node --input-type=module -e \"import fs from 'node:fs'; if (!fs.existsSync('src/opentype/shapers/data.trie')) { console.error('Missing trie files. Run: npm run tries'); process.exit(1); }\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run tries && npm run build",
    "release": "release-it"
  },
  "type": "module",
  "main": "dist/main.cjs",
  "node-module": "dist/module.mjs",
  "browser": "dist/browser.cjs",
  "module": "dist/browser-module.mjs",
  "unpkg": "dist/fontkit.umd.min.js",
  "jsdelivr": "dist/fontkit.umd.min.js",
  "types": "dist/index.d.ts",
  "source": "src/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "types": "./dist/index.d.ts",
        "import": "./dist/module.mjs",
        "require": "./dist/main.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/browser-module.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/browser.cjs"
      },
      "default": "./dist/browser-module.mjs"
    },
    "./unicode-trie": {
      "types": "./dist/unicode-trie/index.d.ts",
      "import": "./dist/unicode-trie/index.mjs",
      "require": "./dist/unicode-trie/index.cjs"
    },
    "./unicode-trie/builder.js": {
      "types": "./dist/unicode-trie/builder.d.ts",
      "import": "./dist/unicode-trie/builder.mjs",
      "require": "./dist/unicode-trie/builder.cjs"
    },
    "./unicode-properties": {
      "types": "./dist/unicode-properties/index.d.ts",
      "import": "./dist/unicode-properties/index.mjs",
      "require": "./dist/unicode-properties/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types"
  ],
  "author": "Devon Govett <devongovett@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/cantoo-scribe/fontkit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "brotli": "^1.3.2",
    "dfa": "^1.2.0",
    "fflate": "^0.8.3",
    "restructure": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.5.0",
    "codepoints": "^1.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "release-it": "^21.0.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
